PGSERVICE=antiscam_backup
PGSERVICEFILE=/etc/antiscam/pg_service.conf
PGPASSFILE=/etc/antiscam/pgpass
BACKUP_DIRECTORY=/var/lib/antiscam/backups
# Keep the latest seven successful scheduled copies on this VPS.
# Pre-update copies are separate and are never removed by daily rotation.
BACKUP_KEEP_COUNT=7
# Optional offsite mode; leave these unset for the agreed local-only setup.
# BACKUP_REMOTE=offsite:antiscam/production
# RCLONE_CONFIG=/etc/antiscam/rclone.conf
# AGE_RECIPIENT=age1REPLACE_WITH_PUBLIC_RECIPIENT
