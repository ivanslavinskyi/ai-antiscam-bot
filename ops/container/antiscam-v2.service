[Unit]
Description=AntiScam V2 container receiver and workers
Requires=docker.service
After=docker.service network-online.target
Wants=network-online.target
ConditionPathExists=/etc/antiscam-v2/ALLOW_V2_START
StartLimitIntervalSec=300
StartLimitBurst=10

[Service]
Type=simple
User=root
WorkingDirectory=/opt/antiscam-bot/deploy
ExecStart=/usr/local/libexec/antiscam-v2-control start
ExecStop=/usr/local/libexec/antiscam-v2-control stop
ExecStopPost=-/usr/local/libexec/antiscam-v2-control stop
Restart=always
RestartSec=10
TimeoutStartSec=90
TimeoutStopSec=120
KillMode=control-group
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=/run/lock
MemoryMax=192M
TasksMax=96
LogRateLimitIntervalSec=30s
LogRateLimitBurst=1000

[Install]
WantedBy=multi-user.target
