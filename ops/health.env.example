DB_URL=postgresql+psycopg://antiscam_health:CHANGE_ME@127.0.0.1:5432/antiscam
BACKUP_DIRECTORY=/var/lib/antiscam/backups
# Daily copy plus a two-hour grace period. No cloud storage is required.
BACKUP_MAX_AGE_SECONDS=93600
# Private check-in URL of an independent monitor with missing-heartbeat alerts.
HEALTHCHECK_SUCCESS_URL=
