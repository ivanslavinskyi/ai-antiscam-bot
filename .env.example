# Store production values outside the checkout, mode 0600. Never commit .env.
TELEGRAM_BOT_TOKEN=
OPENAI_API_KEY=
DB_URL=postgresql+psycopg://antiscam:CHANGE_ME@127.0.0.1:5432/antiscam
# Explicit deployment choice; existing installations must set their model explicitly.
OPENAI_MODEL=gpt-6-luna
WORKER_COUNT=4
LLM_CONCURRENCY=2
OCR_CONCURRENCY=1
LLM_TIMEOUT_SECONDS=20
# Whole serialized system/user text, including context; no silent truncation.
MAX_INPUT_CHARS=16000
# Conservative UTF-8 byte-based token ceiling used for budget reservation.
# This is not measured usage; actual provider tokens settle each reservation.
MAX_INPUT_TOKENS=65536
# USD, UTC calendar day. Set explicit deployment limits; empty means no limit.
GLOBAL_DAILY_BUDGET_USD=1.00
RECOVERY_MODE=false
LOG_LEVEL=INFO
